NODE_ENV=development
PORT=8090

JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=24h
JWT_EXPIRES_IN_HOURS=24

# Dedicated 32-byte secret for encrypting activation tokens.
# In production this MUST be set and kept separate from JWT_SECRET.
ACTIVATION_TOKEN_ENCRYPTION_KEY=

# auto: prefer Supabase when reachable, fall back to local JSON offline.
# local: always use the local JSON store, ignore Supabase entirely.
PERSISTENCE_MODE=auto
SYNC_ENABLED=true

# Postgres connection string. For a self-hosted Supabase instance started with
# `supabase start`, this is printed under "Database" in the CLI output —
# typically postgresql://postgres:postgres@127.0.0.1:54322/postgres.
DATABASE_URL=

# Optional — not required for the direct-Postgres repository path. Only needed
# if you later wire in Supabase Storage, Edge Functions, or Auth directly.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
