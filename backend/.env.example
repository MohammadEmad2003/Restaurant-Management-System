NODE_ENV=development
PORT=8090

JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=24h
JWT_EXPIRES_IN_HOURS=24

# This exact codebase runs in two roles — see config/index.js's own comment
# on isLicenseAuthority for the full explanation:
#   - true  on exactly ONE centrally-hosted, trusted instance (the License
#     Authority). It owns activation-token redemption, hardware binding, and
#     offline-license signing.
#   - unset/false on every packaged desktop install. Activation and hardware
#     binding are instead proxied over HTTPS to LICENSE_AUTHORITY_URL below —
#     there is no local fallback, which is what makes "activation requires
#     the internet" structural rather than advisory.
IS_LICENSE_AUTHORITY=false
# Only meaningful when IS_LICENSE_AUTHORITY is NOT true — the base URL
# (scheme + host, no trailing slash) of the centrally-hosted authority.
LICENSE_AUTHORITY_URL=

# auto: prefer Supabase when reachable, fall back to local JSON offline.
# local: always use the local JSON store, ignore Supabase entirely.
PERSISTENCE_MODE=auto
SYNC_ENABLED=true

# Postgres connection string. For a self-hosted Supabase instance started with
# `supabase start`, this is printed under "Database" in the CLI output —
# typically postgresql://postgres:postgres@127.0.0.1:54322/postgres.
DATABASE_URL=

# Optional — not required for the direct-Postgres repository path. Only needed
# if you later wire in Supabase Storage, Edge Functions, or Auth directly.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
