{
  "name": "restaurant-frontend",
  "version": "1.0.1",
  "description": "Restaurant Management System — React + Electron desktop UI",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "homepage": "https://bellacucina.local",
  "author": {
    "name": "Bella Cucina",
    "email": "support@bellacucina.local"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "predist": "npm run build",
    "dist:linux": "npm run predist && electron-builder --linux",
    "dist:win": "npm run predist && electron-builder --win",
    "dist:mac": "npm run predist && electron-builder --mac"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "i18next": "^23.11.5",
    "lucide-react": "^0.408.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.2",
    "react-router-dom": "^6.24.1",
    "recharts": "^2.12.7",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^24.1.3",
    "vite": "^5.3.3",
    "vitest": "^1.6.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.bellacucina.rms",
    "productName": "Bella Cucina RMS",
    "copyright": "Copyright © 2026",
    "publish": null,
    "directories": {
      "output": "../dist-installer"
    },
    "files": [
      "electron/main.js",
      "electron/preload.js",
      "electron/icon.png",
      "electron/icon.ico",
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "src/**/*",
          "fonts/**/*",
          "package.json",
          "!src/data/**"
        ]
      },
      {
        "from": "dist",
        "to": "frontend-dist"
      },
      {
        "from": "../backend/.env.electron",
        "to": "backend/.env"
      }
    ],
    "afterPack": "scripts/afterPack.cjs",
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "maintainer": "Bella Cucina <support@bellacucina.local>",
      "icon": "electron/icon.png"
    },
    "win": {
      "target": ["nsis"],
      "icon": "electron/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bella Cucina RMS"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.business",
      "icon": "electron/icon.png"
    }
  }
}
